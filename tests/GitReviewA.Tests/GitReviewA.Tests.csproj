<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>GitReviewA.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="NUnit" Version="4.4.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.0.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.7.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>
  <ItemGroup>
    <!-- Der Pfad der Repo-Wurzel zur Bauzeit: die Abtastung liest die gemeinsame Tabelle aus dem Quellbaum (R00058, B5801). -->
    <AssemblyMetadata Include="RepoWurzel" Value="$(MSBuildThisFileDirectory)../../" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\GitReviewA\GitReviewA.csproj" />
  </ItemGroup>
</Project>
